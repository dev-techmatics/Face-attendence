          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200', () => pm.response.to.have.status(200));",
                  "const d = pm.response.json();",
                  "pm.test('rejected', () => pm.expect(d.decision).to.eql('Rejected'));",
                  "pm.test('nobody matched', () => pm.expect(d.personId).to.be.oneOf([null, undefined]));"
