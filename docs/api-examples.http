# Face Attendance API - runnable examples
#
# Works with the VS Code REST Client extension and JetBrains HTTP Client.
# Replace the image paths with real files before running the upload requests.

@host = http://localhost:5080
@adminKey = dev-admin-key
@deviceKey = dev-device-key
@tenant = default

### Health - the only endpoint that needs no key
GET {{host}}/health

### Which engine is live, and what thresholds is it deciding by
# Run this first. If providerId starts with "development" then NO real recognition is
# happening - it matches on upload file name.
GET {{host}}/api/v1/diagnostics/provider
X-Api-Key: {{adminKey}}

### Score a frame without storing anything - use this to check camera placement
POST {{host}}/api/v1/diagnostics/analyze
X-Api-Key: {{adminKey}}
Content-Type: multipart/form-data; boundary=----Boundary

------Boundary
Content-Disposition: form-data; name="image"; filename="frame.jpg"
Content-Type: image/jpeg

< ./samples/alice-front.jpg
------Boundary--

###############################################################################
# Registration
###############################################################################

### One-shot: create the person and store all three poses together
# Rolls the person back if any image is rejected.
POST {{host}}/api/v1/registrations
X-Api-Key: {{adminKey}}
X-Tenant-Id: {{tenant}}
Content-Type: multipart/form-data; boundary=----Boundary

------Boundary
Content-Disposition: form-data; name="externalId"

EMP-1001
------Boundary
Content-Disposition: form-data; name="fullName"

Alice Kumar
------Boundary
Content-Disposition: form-data; name="department"

Operations
------Boundary
Content-Disposition: form-data; name="front"; filename="alice-front.jpg"
Content-Type: image/jpeg

< ./samples/alice-front.jpg
------Boundary
Content-Disposition: form-data; name="left"; filename="alice-left.jpg"
Content-Type: image/jpeg

< ./samples/alice-left.jpg
------Boundary
Content-Disposition: form-data; name="right"; filename="alice-right.jpg"
Content-Type: image/jpeg

< ./samples/alice-right.jpg
------Boundary--

### Step-by-step alternative: create the person first
POST {{host}}/api/v1/persons
X-Api-Key: {{adminKey}}
X-Tenant-Id: {{tenant}}
Content-Type: application/json

{
  "externalId": "EMP-1002",
  "fullName": "Bob Singh",
  "email": "bob@example.com",
  "department": "Maintenance"
}

### Then post each pose to the same person id
# @name captureFront
POST {{host}}/api/v1/persons/10001/faces
X-Api-Key: {{adminKey}}
Content-Type: multipart/form-data; boundary=----Boundary

------Boundary
Content-Disposition: form-data; name="pose"

Front
------Boundary
Content-Disposition: form-data; name="image"; filename="front.jpg"
Content-Type: image/jpeg

< ./samples/bob-front.jpg
------Boundary--

### Enrolment state: poses held, poses missing, how similar they are to each other
GET {{host}}/api/v1/persons/10001/enrollment
X-Api-Key: {{adminKey}}

### Look a person up by your own id
GET {{host}}/api/v1/persons/by-external-id/EMP-1001
X-Api-Key: {{adminKey}}

### Search, paged
GET {{host}}/api/v1/persons?query=alice&enrollmentStatus=Enrolled&page=1&pageSize=25
X-Api-Key: {{adminKey}}

### Download a stored capture (admin only, never cached)
GET {{host}}/api/v1/persons/10001/faces/Front/image
X-Api-Key: {{adminKey}}

### Retire one pose - the person stops being enrolled until it is recaptured
DELETE {{host}}/api/v1/persons/10001/faces/Left
X-Api-Key: {{adminKey}}

### Erase every template and image for a person (data-erasure request)
DELETE {{host}}/api/v1/persons/10001/biometrics
X-Api-Key: {{adminKey}}

###############################################################################
# Attendance
###############################################################################

### 1:1 verification - PREFERRED. Accuracy does not degrade as headcount grows.
POST {{host}}/api/v1/attendance/mark
X-Api-Key: {{deviceKey}}
X-Device-Id: GATE-A
Content-Type: multipart/form-data; boundary=----Boundary

------Boundary
Content-Disposition: form-data; name="externalId"

EMP-1001
------Boundary
Content-Disposition: form-data; name="deviceId"

GATE-A
------Boundary
Content-Disposition: form-data; name="image"; filename="frame.jpg"
Content-Type: image/jpeg

< ./samples/alice-front.jpg
------Boundary--

### 1:N identification - no id supplied. Convenient, less accurate at scale.
POST {{host}}/api/v1/attendance/mark
X-Api-Key: {{deviceKey}}
X-Device-Id: GATE-B
Content-Type: multipart/form-data; boundary=----Boundary

------Boundary
Content-Disposition: form-data; name="deviceId"

GATE-B
------Boundary
Content-Disposition: form-data; name="image"; filename="frame.jpg"
Content-Type: image/jpeg

< ./samples/alice-front.jpg
------Boundary--

### Score a frame without recording it - use this to calibrate thresholds
POST {{host}}/api/v1/attendance/preview
X-Api-Key: {{adminKey}}
Content-Type: multipart/form-data; boundary=----Boundary

------Boundary
Content-Disposition: form-data; name="image"; filename="frame.jpg"
Content-Type: image/jpeg

< ./samples/alice-front.jpg
------Boundary--

### The register, including rejected attempts (that is the audit trail)
GET {{host}}/api/v1/attendance?page=1&pageSize=50
X-Api-Key: {{adminKey}}

### One person, one day
GET {{host}}/api/v1/attendance?personId=10001&fromUtc=2026-10-08T00:00:00Z&toUtc=2026-10-09T00:00:00Z
X-Api-Key: {{adminKey}}

### Only the failures - start here when somebody reports a problem
GET {{host}}/api/v1/attendance?decision=Rejected&pageSize=50
X-Api-Key: {{adminKey}}

###############################################################################
# Expected failures - these SHOULD fail, and are worth running once
###############################################################################

### No key -> 401
GET {{host}}/api/v1/persons

### Device key cannot enrol -> 403
POST {{host}}/api/v1/persons
X-Api-Key: {{deviceKey}}
Content-Type: application/json

{ "externalId": "EMP-9000", "fullName": "Should Fail" }

### Same externalId twice -> 409 external_id_exists
POST {{host}}/api/v1/persons
X-Api-Key: {{adminKey}}
Content-Type: application/json

{ "externalId": "EMP-1001", "fullName": "Duplicate Alice" }
