{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DefaultTenantId": "default",

  "ConnectionStrings": {
    "Default": "Server=.\\SQLEXPRESS;Database=FaceAttendance;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },

  "Database": {
    "MigrateOnStartup": false
  },

  "Cors": {
    "AllowedOrigins": []
  },

  "ApiKeys": {
    "Admin": [],
    "Device": []
  },

  "Storage": {
    "Provider": "local",
    "LocalRootPath": "storage/faces",
    "S3": {
      "BucketName": "",
      "Region": "ap-south-1",
      "KeyPrefix": "faces/",
      "UseServerSideEncryption": true,
      "KmsKeyId": null
    }
  },

  "FaceRecognition": {
    "Provider": "onnx",
    "RequiredPoses": [ "Front", "Left", "Right" ],

    "VerificationThreshold": 0.42,
    "IdentificationThreshold": 0.52,
    "IdentificationMargin": 0.06,
    "DuplicateEnrollmentThreshold": 0.60,
    "MinEnrollmentPairSimilarity": 0.20,

    "RejectDuplicateEnrollments": true,
    "ValidateEnrollmentConsistency": true,
    "RejectDuplicateFrames": true,
    "EnforcePoseCheck": true,
    "MinProfileYawDegrees": 12.0,
    "MaxFrontalYawDegrees": 18.0,

    "MinDetectionScore": 0.60,
    "MinQualityScore": 0.35,
    "MinImageDimension": 240,
    "MinFaceDimension": 80,
    "MaxImageBytes": 8388608,
    "AllowedContentTypes": [ "image/jpeg", "image/jpg", "image/png", "image/webp" ],

    "DuplicatePunchWindowMinutes": 2,
    "InferDirection": true,
    "TopN": 5,

    "StoreProbeImages": true,
    "ProbeImageRetentionDays": 30,

    "Onnx": {
      "DetectorModelPath": "models/scrfd_500m_bnkps.onnx",
      "RecognitionModelPath": "models/arcface_r100.onnx",
      "ModelVersion": "v1",
      "DetectorConfidenceThreshold": 0.5,
      "DetectorNmsThreshold": 0.4,
      "DetectorInputSize": 640,
      "IntraOpThreads": 0,
      "MaxConcurrency": 4,
      "RecognitionInputBgr": false,
      "MirroredInput": false
    },

    "Aws": {
      "Region": "ap-south-1",
      "CollectionId": "face-attendance",
      "SearchThresholdPercent": 80.0,
      "MaxFaces": 5
    }
  }
}
